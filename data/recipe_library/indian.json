    "dairy_free"
   ],
   "method_note": "Thick, not soupy. Add water at the end if you want it looser.",
   "ingredients": [
    {
     "ref": "lentils-red-dry",
     "quantity": 250,
     "unit": "g"
    },
    {
     "ref": "onion-medium",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "ginger-fresh",
     "quantity": 20,
     "unit": "g"
    },
    {
     "ref": "cumin-ground",
     "quantity": 10,
     "unit": "ml"
    },
    {
     "ref": "turmeric-ground",
     "quantity": 5,
     "unit": "ml"
    },
    {
     "ref": "chopped-tomatoes-tinned",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "stock-vegetable",
     "quantity": 700,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Chop {{ing:onion-medium}} finely.",
     "step_group": "Prep"
    },
    {
     "instruction": "Grate {{ing:ginger-fresh}} and chop {{ing:garlic-clove}}.",
     "step_group": "Prep"
    },
    {
     "instruction": "Put a pan on a medium heat with {{ing:vegetable-oil}}.",
     "step_group": "Dhal"
    },
    {
     "instruction": "Cook the onion 8 minutes, until golden.",
     "duration_min": 8,
     "step_group": "Dhal"
    },
    {
     "instruction": "Add the garlic and ginger. Cook 1 minute.",
     "duration_min": 1,
     "step_group": "Dhal"
    },
    {
