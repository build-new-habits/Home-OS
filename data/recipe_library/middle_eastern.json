    {
     "ref": "chickpeas-dry",
     "quantity": 250,
     "unit": "g"
    },
    {
     "ref": "onion-medium",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "cumin-ground",
     "quantity": 10,
     "unit": "ml"
    },
    {
     "ref": "coriander-ground",
     "quantity": 10,
     "unit": "ml"
    },
    {
     "ref": "flour-plain",
     "quantity": 30,
     "unit": "g"
    },
    {
     "ref": "fresh-coriander",
     "quantity": 30,
     "unit": "g"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 60,
     "unit": "ml"
    },
    {
     "ref": "hummus",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "cucumber",
     "quantity": 1,
     "unit": "item"
    }
   ],
   "steps": [
    {
     "instruction": "Soak {{ing:chickpeas-dry}} in cold water overnight.",
     "step_group": "Prep"
    },
    {
     "instruction": "Drain them well and pat dry.",
     "step_group": "Falafel"
    },
    {
     "instruction": "Blitz with {{ing:onion-medium}}, {{ing:garlic-clove}} and {{ing:fresh-coriander}}.",
     "step_group": "Falafel"
    },
    {
     "instruction": "Add {{ing:cumin-ground}}, {{ing:coriander-ground}} and {{ing:flour-plain}}.",
     "step_group": "Falafel"
    },
    {
     "instruction": "Shape into small patties. Chill 20 minutes.",
     "note": "Chilling stops them breaking up in the pan.",
     "duration_min": 20,
     "step_group": "Falafel"
    },
    {
     "instruction": "Fry in {{ing:vegetable-oil}} 4 minutes a side, until deep brown.",
     "duration_min": 8,
     "step_group": "Falafel"
    },
    {
     "instruction": "Slice {{ing:cucumber}}.",
     "step_group": "Bowl"
    },
    {
     "instruction": "Serve with {{ing:hummus}} and the cucumber.",
     "step_group": "Bowl"
    }
   ],
   "swaps": [
