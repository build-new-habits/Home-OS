   "slug": "shakshuka",
   "name": "Shakshuka",
   "cuisine": "Middle Eastern",
   "budget_tier": "budget",
   "default_slot": "breakfast",
   "default_serves": 2,
   "dietary_tags": [
    "vegetarian",
    "gluten_free"
   ],
   "method_note": "The whites should be set and the yolks soft.",
   "ingredients": [
    {
     "ref": "egg-medium",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "chopped-tomatoes-tinned",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "pepper-bell",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "onion-medium",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "cumin-ground",
     "quantity": 10,
     "unit": "ml"
    },
    {
     "ref": "paprika",
     "quantity": 5,
     "unit": "ml"
    },
    {
     "ref": "olive-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "fresh-parsley",
     "quantity": 15,
     "unit": "g"
    }
   ],
   "steps": [
    {
     "instruction": "Chop {{ing:onion-medium}} and {{ing:pepper-bell}}."
    },
    {
     "instruction": "Put a wide pan on a medium heat with {{ing:olive-oil}}."
    },
    {
     "instruction": "Cook the onion and pepper 10 minutes, until soft.",
     "duration_min": 10
    },
    {
     "instruction": "Chop {{ing:garlic-clove}} and add it. Cook 1 minute.",
     "duration_min": 1
    },
    {
     "instruction": "Add {{ing:cumin-ground}} and {{ing:paprika}}. Stir 30 seconds.",
     "duration_min": 1
    },
    {
     "instruction": "Add {{ing:chopped-tomatoes-tinned}}. Simmer 12 minutes, until thick.",
     "duration_min": 12
    },
    {
     "instruction": "Make four dips. Crack {{ing:egg-medium}} into them."
    },
    {
     "instruction": "Cover and cook 7 minutes, until the whites set.",
     "duration_min": 7
    },
    {
     "instruction": "Chop {{ing:fresh-parsley}} over."
    }
   ]
