   ],
   "method_note": null,
   "ingredients": [
    {
     "ref": "couscous-dry",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "fresh-parsley",
     "quantity": 50,
     "unit": "g"
    },
    {
     "ref": "tomato-medium",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "spring-onion",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "lemon",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "olive-oil",
     "quantity": 45,
     "unit": "ml"
    },
    {
     "ref": "cucumber",
     "quantity": 1,
     "unit": "item"
    }
   ],
   "steps": [
    {
     "instruction": "Put {{ing:couscous-dry}} in a bowl. Pour over 250 ml boiling water."
    },
    {
     "instruction": "Cover and leave 10 minutes.",
     "duration_min": 10
    },
    {
     "instruction": "Chop {{ing:fresh-parsley}} finely.",
     "while_waiting": true
    },
    {
     "instruction": "Chop {{ing:tomato-medium}}, {{ing:cucumber}} and {{ing:spring-onion}} small."
    },
    {
     "instruction": "Fluff the couscous with a fork."
    },
    {
     "instruction": "Mix everything together."
    },
    {
