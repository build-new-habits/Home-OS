     "quantity": 15,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Chop {{ing:onion-large}} and {{ing:pepper-bell}}.",
     "step_group": "Prep"
    },
    {
     "instruction": "Put a large pan on a medium heat with {{ing:vegetable-oil}}.",
     "step_group": "Chilli"
    },
    {
     "instruction": "Cook the onion and pepper 8 minutes.",
     "duration_min": 8,
     "step_group": "Chilli"
    },
    {
     "instruction": "Chop {{ing:garlic-clove}} and add it. Cook 1 minute.",
     "duration_min": 1,
     "step_group": "Chilli"
    },
    {
     "instruction": "Add {{ing:beef-mince-20-fat}}. Break it up. Cook 8 minutes.",
     "duration_min": 8,
     "step_group": "Chilli"
    },
    {
