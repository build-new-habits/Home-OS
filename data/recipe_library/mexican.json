     "duration_min": 1,
     "step_group": "Chilli"
    },
    {
     "instruction": "Add {{ing:chopped-tomatoes-tinned}}. Simmer 30 minutes.",
     "duration_min": 30,
     "step_group": "Chilli"
    },
    {
     "instruction": "Drain {{ing:kidney-beans-tinned}} and add them. Cook 10 minutes.",
     "duration_min": 10,
     "step_group": "Chilli"
    },
    {
     "instruction": "Cook {{ing:rice-basmati-dry}} in 600 ml water, covered, 12 minutes.",
     "duration_min": 12,
     "step_group": "Rice",
     "while_waiting": true
    }
