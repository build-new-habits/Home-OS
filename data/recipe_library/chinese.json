  {
   "slug": "egg-fried-rice",
   "name": "Egg fried rice",
   "cuisine": "Chinese",
   "budget_tier": "budget",
   "default_slot": "dinner",
   "default_serves": 4,
   "dietary_tags": [
    "vegetarian"
   ],
   "method_note": "Cold, day-old rice works best. Fresh rice goes sticky.",
   "ingredients": [
    {
     "ref": "rice-basmati-dry",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "egg-medium",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "peas-frozen",
     "quantity": 150,
     "unit": "g"
    },
    {
     "ref": "spring-onion",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "soy-sauce",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "sesame-oil",
     "quantity": 10,
     "unit": "ml"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "garlic-clove",
     "quantity": 2,
     "unit": "item"
    }
   ],
   "steps": [
    {
     "instruction": "Cook {{ing:rice-basmati-dry}} in 600 ml water, covered, 12 minutes.",
     "duration_min": 12,
     "step_group": "Rice"
    },
    {
     "instruction": "Spread it on a tray to cool.",
     "note": "Steaming hot rice will clump in the pan.",
     "step_group": "Rice"
    },
    {
     "instruction": "Chop {{ing:spring-onion}} and {{ing:garlic-clove}}.",
     "step_group": "Prep",
     "while_waiting": true
    },
    {
     "instruction": "Beat {{ing:egg-medium}} in a bowl.",
     "step_group": "Prep"
    },
    {
     "instruction": "Put a wide pan on a high heat with {{ing:vegetable-oil}}.",
     "step_group": "Fry"
    },
    {
     "instruction": "Pour in the egg. Scramble 1 minute. Lift it out.",
     "duration_min": 1,
     "step_group": "Fry"
    },
    {
     "instruction": "Add the garlic. Stir 30 seconds.",
     "duration_min": 1,
     "step_group": "Fry"
    },
    {
     "instruction": "Add the rice and {{ing:peas-frozen}}. Fry 4 minutes.",
     "duration_min": 4,
     "step_group": "Fry"
    },
    {
     "instruction": "Put the egg back. Add {{ing:soy-sauce}} and {{ing:sesame-oil}}.",
     "step_group": "Fry"
    },
    {
     "instruction": "Scatter the spring onions over.",
     "step_group": "Finish"
    }
   ]
  },
  {
