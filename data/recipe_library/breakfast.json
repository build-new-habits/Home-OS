   "method_note": "Made the night before. Nothing to do in the morning.",
   "ingredients": [
    {
     "ref": "oats-rolled",
     "quantity": 100,
     "unit": "g"
    },
    {
     "ref": "natural-yoghurt",
     "quantity": 200,
     "unit": "ml"
    },
