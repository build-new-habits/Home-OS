    },
    {
     "ref": "salt",
     "quantity": 5,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Put a pan of water on a high heat until it boils."
    },
    {
     "instruction": "Lower in {{ing:egg-medium}}. Boil 6 minutes for runny yolks.",
     "duration_min": 6
    },
    {
