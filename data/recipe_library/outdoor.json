  {
   "slug": "out-skillet-nachos",
   "name": "Campfire skillet nachos",
   "cuisine": "Outdoor cooking",
   "budget_tier": "budget",
   "default_slot": "dinner",
   "default_serves": 6,
   "dietary_tags": [
    "vegetarian"
   ],
   "method_note": "Use thick oven gloves. The pan handle gets very hot.",
   "course": "starter",
   "ingredients": [
    {
     "ref": "tortilla-chips",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "kidney-beans-tinned",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "cheddar-cheese",
     "quantity": 150,
     "unit": "g"
    },
    {
     "ref": "salsa-dip",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "chilli-fresh",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "spring-onion",
     "quantity": 3,
     "unit": "item"
    }
   ],
   "steps": [
    {
     "instruction": "Put a cast-iron pan on a grill over the fire."
    },
    {
     "instruction": "Layer {{ing:tortilla-chips}}, drained {{ing:kidney-beans-tinned}} and grated {{ing:cheddar-cheese}}."
