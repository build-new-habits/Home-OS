   "slug": "out-bread-on-a-stick",
   "name": "Campfire bread on a stick",
   "cuisine": "Outdoor cooking",
   "budget_tier": "budget",
   "default_slot": "dinner",
   "default_serves": 8,
   "dietary_tags": [
    "vegetarian",
    "vegan",
    "dairy_free"
   ],
   "method_note": "Embers, not flames: flames burn the outside before the middle cooks.",
   "course": "starter",
   "ingredients": [
    {
     "ref": "flour-self-raising",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "baking-powder",
     "quantity": 5,
     "unit": "ml"
    },
    {
     "ref": "salt",
     "quantity": 2.5,
     "unit": "ml"
    },
    {
     "ref": "olive-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "jam-strawberry",
     "quantity": 60,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Mix {{ing:flour-self-raising}}, {{ing:baking-powder}} and {{ing:salt}} at home. Pack in a bag."
    },
    {
     "instruction": "At camp, add {{ing:olive-oil}} and about 180 ml water. Knead to a soft dough."
    },
    {
     "instruction": "Roll into 8 long snakes. Wind each round the end of a clean green stick."
    },
    {
     "instruction": "Hold over hot embers, not flames, 10 minutes, turning, until golden and hollow-sounding.",
     "duration_min": 10
    },
    {
     "instruction": "Slide off. Fill the hole with {{ing:jam-strawberry}}."
    }
   ]
