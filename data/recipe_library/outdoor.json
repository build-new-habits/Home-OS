  {
   "slug": "out-scotch-eggs",
   "name": "Picnic Scotch eggs",
   "cuisine": "Outdoor cooking",
   "budget_tier": "budget",
   "default_slot": "dinner",
   "default_serves": 6,
   "dietary_tags": [
    "dairy_free"
   ],
   "method_note": "Make at home the day before. They travel well in a cool box.",
   "course": "starter",
   "ingredients": [
    {
     "ref": "egg-medium",
     "quantity": 7,
     "unit": "item"
    },
    {
     "ref": "sausagemeat",
     "quantity": 400,
     "unit": "g"
    },
    {
     "ref": "fresh-sage",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "flour-plain",
     "quantity": 45,
     "unit": "ml"
    },
    {
     "ref": "breadcrumbs-dried",
     "quantity": 100,
     "unit": "g"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 30,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Boil 6 of {{ing:egg-medium}} 7 minutes. Cool in cold water. Peel.",
     "duration_min": 7
    },
    {
     "instruction": "Chop {{ing:fresh-sage}}. Mix into {{ing:sausagemeat}}. Split into 6."
    },
    {
     "instruction": "Flatten each piece. Wrap round an egg. Seal well."
    },
    {
     "instruction": "Roll in {{ing:flour-plain}}, then the last egg beaten, then {{ing:breadcrumbs-dried}}."
    },
    {
     "instruction": "Heat the oven to 200C. Brush with {{ing:vegetable-oil}}. Bake 25 minutes, until golden and cooked through.",
     "duration_min": 25
    },
    {
     "instruction": "Cool. Pack for the picnic."
    }
   ]
  },
