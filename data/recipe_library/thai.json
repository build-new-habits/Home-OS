     "unit": "g"
    },
    {
     "ref": "egg-medium",
     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "spring-onion",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "fish-sauce",
     "quantity": 30,
     "unit": "ml"
    },
    {
