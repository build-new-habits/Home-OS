  {
   "slug": "thai-green-veg-curry",
   "name": "Green vegetable curry",
   "cuisine": "Thai",
   "budget_tier": "everyday",
   "default_slot": "dinner",
   "default_serves": 4,
   "dietary_tags": [
    "vegetarian",
    "vegan",
    "gluten_free",
    "dairy_free"
   ],
   "method_note": null,
   "ingredients": [
    {
     "ref": "curry-paste",
     "quantity": 60,
     "unit": "g"
    },
    {
     "ref": "coconut-milk-tinned",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "green-beans",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "pepper-bell",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "aubergine",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "rice-basmati-dry",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "fish-sauce",
     "quantity": 15,
     "unit": "ml"
    },
    {
     "ref": "lime",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 15,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Cut {{ing:aubergine}} and {{ing:pepper-bell}} into chunks.",
     "step_group": "Prep"
    },
    {
     "instruction": "Put a wide pan on a medium heat with {{ing:vegetable-oil}}.",
     "step_group": "Curry"
    },
    {
     "instruction": "Add {{ing:curry-paste}}. Fry 2 minutes, until it smells strong.",
     "duration_min": 2,
     "step_group": "Curry"
    },
    {
     "instruction": "Pour in {{ing:coconut-milk-tinned}}. Stir until smooth.",
     "step_group": "Curry"
    },
    {
     "instruction": "Add the aubergine. Simmer 10 minutes.",
     "duration_min": 10,
     "step_group": "Curry"
    },
    {
     "instruction": "Add the pepper and {{ing:green-beans}}. Cook 6 minutes.",
     "duration_min": 6,
     "step_group": "Curry"
    },
    {
     "instruction": "Cook {{ing:rice-basmati-dry}} in 600 ml water, covered, 12 minutes.",
     "duration_min": 12,
     "step_group": "Rice",
     "while_waiting": true
    },
    {
     "instruction": "Add {{ing:fish-sauce}} to the curry. Taste.",
     "step_group": "Finish"
    },
    {
     "instruction": "Squeeze {{ing:lime}} in.",
     "step_group": "Finish"
    }
   ]
  },
