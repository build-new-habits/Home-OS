     "quantity": 15,
     "unit": "g"
    }
   ],
   "steps": [
    {
     "instruction": "Soak {{ing:rice-noodles-dry}} in hot water 8 minutes. Drain.",
     "duration_min": 8,
     "step_group": "Prep"
    },
    {
     "instruction": "Chop {{ing:spring-onion}} and {{ing:garlic-clove}}.",
     "step_group": "Prep"
    },
    {
     "instruction": "Crush {{ing:peanuts}} roughly.",
     "step_group": "Prep"
    },
    {
     "instruction": "Mix {{ing:fish-sauce}} and {{ing:sugar-soft-brown}} in a cup.",
     "step_group": "Prep"
