     "unit": "g"
    },
    {
     "ref": "cocoa-powder",
     "quantity": 30,
     "unit": "g"
    }
   ],
   "steps": [
    {
     "instruction": "Heat the oven to 170C. Line a round tin."
    },
    {
     "instruction": "Melt {{ing:dark-chocolate}} and {{ing:butter-block}} in a bowl over hot water."
    },
    {
     "instruction": "Let it cool 5 minutes.",
     "note": "Hot chocolate will scramble the eggs.",
     "duration_min": 5
    },
    {
