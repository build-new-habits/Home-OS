     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "kale",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "butter-block",
     "quantity": 60,
     "unit": "g"
    },
    {
     "ref": "lemon",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "olive-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "potato-medium",
     "quantity": 4,
     "unit": "item"
    }
   ],
   "steps": [
    {
     "instruction": "Peel {{ing:potato-medium}} and boil 18 minutes.",
     "duration_min": 18,
     "step_group": "Potatoes"
    },
    {
     "instruction": "Drain and mash with half of {{ing:butter-block}}.",
     "step_group": "Potatoes"
    },
    {
     "instruction": "Pat {{ing:sea-bass-fillet}} dry with kitchen paper.",
     "note": "Wet skin will not crisp.",
     "step_group": "Fish"
    },
    {
     "instruction": "Put a frying pan on a high heat with {{ing:olive-oil}}.",
     "step_group": "Fish"
    },
    {
     "instruction": "Lay the fish in skin side down. Press it flat for 10 seconds.",
     "step_group": "Fish"
    },
    {
     "instruction": "Cook 4 minutes without moving it.",
     "duration_min": 4,
     "step_group": "Fish"
    },
    {
     "instruction": "Turn it over. Cook 1 minute more, then lift out.",
     "duration_min": 1,
     "step_group": "Fish"
    },
    {
     "instruction": "Chop {{ing:garlic-clove}}. Add it to the pan with {{ing:kale}}.",
     "step_group": "Greens"
    },
    {
     "instruction": "Cook 4 minutes, until the kale is bright and wilted.",
     "duration_min": 4,
     "step_group": "Greens"
    },
    {
     "instruction": "Add the rest of the butter and a squeeze of {{ing:lemon}}.",
     "step_group": "Greens"
    }
   ]
  },
