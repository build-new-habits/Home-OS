   "method_note": "Dense on purpose. It should sink slightly in the middle.",
   "ingredients": [
    {
     "ref": "dark-chocolate",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "butter-block",
     "quantity": 200,
