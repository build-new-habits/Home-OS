  {
   "slug": "beef-wellington-style",
   "name": "Beef in pastry",
   "cuisine": "Special",
   "budget_tier": "special",
   "default_slot": "dinner",
   "default_serves": 4,
   "dietary_tags": [],
   "method_note": "The mushroom layer has to be dry or the pastry goes soggy. That is the whole recipe.",
   "ingredients": [
    {
     "ref": "beef-mince-5-fat",
     "quantity": 600,
     "unit": "g"
    },
    {
     "ref": "mushroom-chestnut",
     "quantity": 400,
     "unit": "g"
    },
    {
     "ref": "garlic-clove",
     "quantity": 3,
     "unit": "item"
    },
    {
     "ref": "flour-plain",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "butter-block",
     "quantity": 150,
     "unit": "g"
    },
    {
     "ref": "egg-medium",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "dried-thyme",
     "quantity": 5,
     "unit": "ml"
    },
    {
     "ref": "mustard-dijon",
     "quantity": 15,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Rub {{ing:butter-block}} into {{ing:flour-plain}} until it looks like crumbs.",
     "step_group": "Pastry"
    },
    {
     "instruction": "Add cold water a spoon at a time until it comes together.",
     "step_group": "Pastry"
    },
    {
     "instruction": "Wrap and chill 30 minutes.",
     "duration_min": 30,
     "step_group": "Pastry"
    },
    {
     "instruction": "Blitz {{ing:mushroom-chestnut}} and {{ing:garlic-clove}} very finely.",
     "step_group": "Filling",
     "while_waiting": true
    },
    {
     "instruction": "Fry them in a dry pan 15 minutes, until no liquid is left.",
     "note": "Keep going past when you think it is done.",
     "duration_min": 15,
     "step_group": "Filling"
    },
    {
     "instruction": "Add {{ing:dried-thyme}}. Cool completely.",
     "step_group": "Filling"
    },
    {
     "instruction": "Heat the oven to 200C.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Shape {{ing:beef-mince-5-fat}} into a firm log.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Brush it with {{ing:mustard-dijon}}.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Roll the pastry out. Spread the mushrooms over the middle.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Lay the beef on and wrap the pastry round, sealing the edges.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Beat {{ing:egg-medium}} and brush it all over.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Bake 35 minutes, until deep golden.",
     "duration_min": 35,
     "step_group": "Bake"
    },
    {
     "instruction": "Rest 15 minutes before cutting.",
     "note": "Cutting early loses the juices onto the board.",
     "duration_min": 15,
     "step_group": "Bake"
    }
   ]
  },
