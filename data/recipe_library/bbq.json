   "cuisine": "BBQ",
   "budget_tier": "budget",
   "default_slot": "dinner",
   "default_serves": 6,
   "dietary_tags": [
    "vegetarian",
    "vegan",
    "dairy_free"
   ],
   "method_note": "The charred skin is where the smoke comes from.",
   "course": "starter",
   "ingredients": [
