     "ref": "aubergine",
     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "tahini",
     "quantity": 45,
     "unit": "ml"
    },
    {
     "ref": "lemon",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "garlic-clove",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "olive-oil",
     "quantity": 30,
     "unit": "ml"
    },
    {
     "ref": "pomegranate-seeds",
     "quantity": 40,
     "unit": "g"
    },
    {
     "ref": "pitta-bread",
     "quantity": 4,
     "unit": "item"
    }
   ],
   "steps": [
