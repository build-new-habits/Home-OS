  {
   "slug": "flapjacks",
   "name": "Flapjacks",
   "cuisine": "Snacks",
   "budget_tier": "budget",
   "default_slot": "snack",
   "default_serves": 12,
   "dietary_tags": [
    "vegetarian"
   ],
   "method_note": null,
   "ingredients": [
    {
     "ref": "oats-rolled",
     "quantity": 300,
     "unit": "g"
    },
    {
     "ref": "butter-block",
     "quantity": 200,
     "unit": "g"
    },
    {
     "ref": "golden-syrup",
     "quantity": 100,
     "unit": "ml"
    },
    {
     "ref": "sugar-soft-brown",
     "quantity": 100,
     "unit": "g"
    }
   ],
   "steps": [
    {
     "instruction": "Heat the oven to 170C. Line a tin."
    },
    {
     "instruction": "Melt {{ing:butter-block}}, {{ing:golden-syrup}} and {{ing:sugar-soft-brown}} in a pan."
    },
    {
     "instruction": "Stir until the sugar has dissolved."
    },
    {
     "instruction": "Take off the heat. Stir in {{ing:oats-rolled}}."
    },
    {
     "instruction": "Press into the tin firmly.",
     "note": "Loose flapjack crumbles when you cut it."
    },
    {
     "instruction": "Bake 25 minutes, until golden at the edges.",
     "duration_min": 25
    },
    {
     "instruction": "Cut into squares while warm. Cool in the tin."
    }
   ]
