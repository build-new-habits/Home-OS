   "slug": "shepherds-pie",
   "name": "Shepherd's pie",
   "cuisine": "British",
   "budget_tier": "everyday",
   "default_slot": "dinner",
   "default_serves": 4,
   "dietary_tags": [],
   "method_note": "Lamb makes it shepherd's; beef makes it cottage.",
   "ingredients": [
    {
     "ref": "lamb-mince",
     "quantity": 500,
     "unit": "g"
    },
    {
     "ref": "potato-large",
     "quantity": 4,
     "unit": "item"
    },
    {
     "ref": "onion-medium",
     "quantity": 1,
     "unit": "item"
    },
    {
     "ref": "carrot-medium",
     "quantity": 2,
     "unit": "item"
    },
    {
     "ref": "stock-chicken",
     "quantity": 300,
     "unit": "ml"
    },
    {
     "ref": "butter-block",
     "quantity": 50,
     "unit": "g"
    },
    {
     "ref": "milk-semi-skimmed",
     "quantity": 60,
     "unit": "ml"
    },
    {
     "ref": "vegetable-oil",
     "quantity": 15,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "instruction": "Heat the oven to 200C.",
     "step_group": "Prep"
    },
    {
     "instruction": "Peel {{ing:potato-large}} and cut into chunks.",
     "step_group": "Mash"
    },
    {
     "instruction": "Boil them 18 minutes, until a knife slides in with no resistance.",
     "duration_min": 18,
     "step_group": "Mash"
    },
    {
     "instruction": "Chop {{ing:onion-medium}} and {{ing:carrot-medium}} small.",
     "step_group": "Filling",
     "while_waiting": true
    },
    {
     "instruction": "Put a pan on a medium heat with {{ing:vegetable-oil}}.",
     "step_group": "Filling"
    },
    {
     "instruction": "Cook the onion and carrot 8 minutes, until soft.",
     "duration_min": 8,
     "step_group": "Filling"
    },
    {
     "instruction": "Add {{ing:lamb-mince}}. Break it up. Cook 8 minutes.",
     "note": "Until no pink is left.",
     "duration_min": 8,
     "step_group": "Filling"
    },
    {
     "instruction": "Pour in {{ing:stock-chicken}}. Simmer 20 minutes, until thick.",
     "duration_min": 20,
     "step_group": "Filling"
    },
    {
     "instruction": "Drain the potatoes. Add {{ing:butter-block}} and {{ing:milk-semi-skimmed}}.",
     "step_group": "Mash"
    },
    {
     "instruction": "Mash until smooth.",
     "step_group": "Mash"
    },
    {
     "instruction": "Spread the mash over the lamb in an oven dish.",
     "note": "Work from the edges in so it does not sink.",
     "step_group": "Assemble"
    },
    {
     "instruction": "Bake 25 minutes, until browned in patches.",
     "duration_min": 25,
     "step_group": "Assemble"
    }
   ]
  },
